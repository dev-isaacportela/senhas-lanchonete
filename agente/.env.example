# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Endereco publico do servidor. Use https:// — o socket.io negocia o wss sozinho.
SERVIDOR_URL=https://seu.dominio.com.br

# Precisa ser identico ao AGENTE_TOKEN definido no servidor.
# Gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENTE_TOKEN=troque-este-valor
